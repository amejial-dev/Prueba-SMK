PORT=3000

DB_HOST=db
DB_PORT=5432
DB_NAME=prueba_smk
DB_USER=postgres
DB_PASSWORD=postgres

# Deben coincidir con DB_NAME/DB_USER/DB_PASSWORD: las lee el contenedor
# de Postgres directamente (imagen oficial), Sequelize sigue usando DB_*.
POSTGRES_DB=prueba_smk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=1d

# Límite de tamaño (en MB) para los archivos CSV subidos.
MAX_CSV_FILE_SIZE_MB=5

# Solo se usan al ejecutar `npm run seed:admin` (no las lee el servidor Express)
ADMIN_SEED_NOMBRE=admin
ADMIN_SEED_PASSWORD=cambia-esta-clave
